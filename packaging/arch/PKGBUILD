# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=aco-arch-dotfiles-tmux
pkgver=0.3.0
pkgrel=1
pkgdesc='Tmux configuration with vendored plugins'
arch=('any')
url='https://github.com/Akademie-Olympia/aco-arch-dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('aco-arch-dotfiles-core>=0.3.0' 'tmux>=3.3' 'bash' 'git' 'fzf')
optdepends=()
replaces=('arch-dotfiles-tmux')
conflicts=('arch-dotfiles-tmux')
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
